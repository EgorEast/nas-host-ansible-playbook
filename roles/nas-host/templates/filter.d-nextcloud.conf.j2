# Managed by nas-host ansible role.
# Nextcloud filter — парсит JSON-логи NC.
# Nextcloud log entry (кусочек):
#   {"reqId":"...","level":2,"time":"...","remoteAddr":"1.2.3.4",...,
#    "message":"Login failed: ...","userAgent":"..."}

[Definition]

# Failed login (стандартный "Login failed: <username>")
# и bruteforce attempts (лог bruteforcesettings-app).
failregex = ^\{.*"remoteAddr":"<HOST>".*(?:Login failed|Trusted domain error|Bruteforce attempt from).*$

ignoreregex =

datepattern = "time"\s*:\s*"%%Y-%%m-%%dT%%H:%%M:%%S
