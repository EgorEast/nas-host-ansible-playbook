#!/bin/bash
# Managed by ansible (nas-host role). Local edits will be overwritten.
# Триггерится при критическом заряде, прямо перед shutdown
{% if nas_ups_ntfy_url %}
curl -s -n --netrc-file {{ nas_ups_ntfy_netrc_file }} -d "{{ nas_ups_ntfy_lowbatt_message }}" \
  {{ nas_ups_ntfy_url }}
{% else %}
echo "Warning: The UPS's battery power is not enough, system will be shutdown soon!" | wall
{% endif %}

